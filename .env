# APGI Framework Environment Configuration Settings
APGI_ENV=development
APGI_DEBUG=false
APGI_LOG_LEVEL=INFO

# Database Settings
APGI_DB_PATH=/app/data/apgi.db
APGI_DB_BACKUP_PATH=/app/data/backups/

# GUI Settings
APGUI_THEME=dark
APGUI_FONT_SIZE=12
APGUI_WINDOW_WIDTH=1400
APGUI_WINDOW_HEIGHT=900

# Security Settings
APGI_SECRET_KEY=your-new-secret-key-here-replace-with-random-64-char-hex
APGI_SESSION_TIMEOUT=3600

# Performance Settings
APGI_MAX_WORKERS=4
APGI_THREAD_POOL_SIZE=8
APGI_MEMORY_LIMIT=2g

# Data Paths
APGI_DATA_DIR=/app/data
APGI_OUTPUTS_DIR=/app/apgi_outputs
APGI_SESSIONS_DIR=/app/session_state
APGI_LOGS_DIR=/app/logs

# External Service URLs (if applicable)
# APGI_EEG_SERVICE_URL=http://eeg-service:8080
# APGI_PUPILLOMETRY_SERVICE_URL=http://pupillometry-service:8081

# Monitoring
APGI_METRICS_ENABLED=true
APGI_HEALTH_CHECK_INTERVAL=30

# Docker Service Credentials
POSTGRES_PASSWORD=change-this-to-a-secure-password-in-production
JUPYTER_TOKEN=change-this-to-a-secure-token-in-production
GF_ADMIN_PASSWORD=change-this-to-a-secure-password-in-production

# APGI Desktop GUI Configuration
APP_NAME="APGI Assistant"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL="INFO"
LOG_FILE="apgi_gui.log"
LOG_MAX_BYTES="1048576"
LOG_BACKUP_COUNT="5"
WINDOW_WIDTH="1400"
WINDOW_HEIGHT="900"
THEME="default"
CONFIG_FILE=".apgi_gui_config.json"
SESSION_FILE=".apgi_gui_session.json"
RESULTS_DIR="results"
LOGS_DIR="logs"
DEFAULT_HR="70"
DEFAULT_HRV="50"
DEFAULT_RESP="16"
DEFAULT_EDA="5.0"
MAX_STATE_HISTORY="100"
MAX_ENERGY_HISTORY="50"
MAX_QUERY_HISTORY="20"
HAS_MATPLOTLIB="true"
HAS_PIL="true"
HAS_TRANSFORMERS="false"
HAS_PSUTIL="false"
HAS_TORCHDIFFEQ="false"

# API Configuration
API_TITLE="APGI System API"
API_VERSION="1.0.0"

# Server Settings
HOST="0.0.0.0"
PORT=8000
RELOAD=true

# Database Settings
DATABASE_URL="postgresql://localhost:5432/apgi_api"

# Redis Settings
REDIS_URL="redis://localhost:6379/0"

# Celery Settings
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Authentication Settings
ENVIRONMENT="development"
JWT_SECRET_KEY="testing-secret-key-at-least-64-characters-long-for-production-compliance-verification"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting Settings
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Docker Compose Database Variables
POSTGRES_USER=apgi
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=apgi_api