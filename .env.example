# APGI Framework Environment Configuration
# Copy this file to .env and fill in the values

# Application Settings
APGI_ENV=development
# Set to false for production - never enable debug mode in production
APGI_DEBUG=false
# Set to true for production to fail startup on configuration errors
APGI_STRICT_MODE=false
APGI_LOG_LEVEL=INFO

# Database Settings
APGI_DB_PATH=data/apgi.db
APGI_DB_BACKUP_PATH=data/backups/

# GUI Settings
APGUI_THEME=dark
APGUI_FONT_SIZE=12
APGUI_WINDOW_WIDTH=1400
APGUI_WINDOW_HEIGHT=900

# Security Settings
APGI_SECRET_KEY=your-secret-key-here-replace-with-random-64-char-hex
APGI_SESSION_TIMEOUT=3600

# Performance Settings
APGI_MAX_WORKERS=4
APGI_THREAD_POOL_SIZE=8
APGI_MEMORY_LIMIT=2g

# Data Paths
APGI_DATA_DIR=data
APGI_OUTPUTS_DIR=apgi_output
APGI_SESSIONS_DIR=session_state
APGI_LOGS_DIR=logs

# External Service URLs (if applicable)
# APGI_EEG_SERVICE_URL=http://eeg-service:8080
# APGI_PUPILLOMETRY_SERVICE_URL=http://pupillometry-service:8081

# Monitoring
APGI_METRICS_ENABLED=true
APGI_HEALTH_CHECK_INTERVAL=30

# Docker Service Credentials
POSTGRES_PASSWORD=your-secure-postgres-password-here
JUPYTER_TOKEN=your-secure-jupyter-token-here
GF_ADMIN_PASSWORD=your-secure-grafana-admin-password-here

# Database Configuration
POSTGRES_USER=apgi
POSTGRES_PASSWORD=apgi_password
POSTGRES_DB=apgi_api
DATABASE_URL=postgresql://apgi:apgi_password@localhost:5432/apgi_api?sslmode=require

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Authentication (REQUIRED — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
# NEVER commit or deploy the placeholder below. Replace it with a strong random value.
JWT_SECRET_KEY=REPLACE_ME_WITH_RANDOM_64_CHAR_SECRET

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Schema Validation
SCHEMA_VALIDATION_ENABLED=true
SCHEMA_VALIDATION_FAIL_ON_ERROR=false

# Alerting
ALERT_ERROR_RATE_THRESHOLD=10
ALERT_ERROR_RATE_WINDOW_MINUTES=1
ALERT_COOLDOWN_MINUTES=5
